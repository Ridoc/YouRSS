# Copy to .env for local development; never commit real secrets.
LOGURU_LEVEL=DEBUG
YOURSS_USERS_FILE=samples/users.yaml
# YOURSS_WARMUP_ENABLED=true
# YOURSS_CUSTOM_PAGES_ENABLED=true
# YOURSS_MAX_PAGE_ITEMS=12
YOURSS_API_DOCS_ENABLED=true
YOURSS_CLEAN_TITLES=true
YOURSS_CACHE_ENABLED=true
YOURSS_CACHE_FOLDER=./yourss-cache
# YOURSS_CACHE_RSS_TTL=PT30M
# YOURSS_CACHE_RSS_FALLBACK_TTL=PT48H
# YOURSS_CACHE_METADATA_TTL=PT24H

# YouRSS+ accounts
# YOURSS_DB_PATH=./yourss.db
# YOURSS_SECRET_KEY=change-me-to-at-least-32-random-bytes
# YOURSS_PUBLIC_BASE_URL=https://yourss.example
# YOURSS_REGISTRATION_ENABLED=false
# YOURSS_ADMIN_EMAIL=admin@example.com
# YOURSS_ADMIN_USERNAME=admin
# YOURSS_PRIVATE=false
# YOURSS_NOINDEX=false
# YOURSS_SMTP_HOST=smtp.example.com
# YOURSS_SMTP_PORT=587
# YOURSS_SMTP_STARTTLS=true
# YOURSS_SMTP_FROM=YourRSS+ <no-reply@example.com>
# YOURSS_TURNSTILE_SITE_KEY=
# YOURSS_TURNSTILE_SECRET_KEY=
# YOURSS_FORWARDED_ALLOW_IPS=127.0.0.1
