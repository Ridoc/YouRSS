{% extends "pages/base.jinja-html" %}
{% block content %}
<section class="yourss-account" aria-labelledby="yourss-admin-title">
  <header class="yourss-account-head">
    <div>
      <p class="yourss-eyebrow"><a href="/account">Your account</a></p>
      <h1 id="yourss-admin-title">Users</h1>
      <p class="yourss-muted">{{ users|length }} accounts</p>
    </div>
    <a class="yourss-btn" href="/admin/status">Warm-up status</a>
  </header>

  <p class="yourss-muted">Admin email: {{ admin_email or "not configured" }}{% if admin_username %} · admin username: {{ admin_username }}{% endif %}</p>

  <div class="yourss-table-wrap">
    <table class="yourss-table">
      <thead><tr><th>User</th><th>Email</th><th>Role</th><th>Pages</th><th>Watched</th><th>Actions</th></tr></thead>
      <tbody>
      {% for user in users %}
        <tr>
          <td>{{ user.username }}{% if user.disabled_at %} <span class="yourss-muted">(disabled)</span>{% endif %}</td>
          <td>{{ user.email or "—" }}</td>
          <td>{{ user.role }}</td>
          <td>{{ user.page_count }}</td>
          <td>{{ user.watched_count }}</td>
          <td>
            <form method="post" action="/admin/users/{{ user.id }}/email" class="yourss-inline-form">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
              <label class="yourss-visually-hidden" for="email-{{ user.id }}">Email for {{ user.username }}</label>
              <input id="email-{{ user.id }}" name="email" type="email" value="{{ user.email or '' }}" placeholder="email@example.com" />
              <button class="yourss-btn" type="submit">Set email</button>
            </form>
            {% if user.email %}
            <form method="post" action="/admin/users/{{ user.id }}/send-link" class="yourss-inline-form">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
              <button class="yourss-btn" type="submit">Send sign-in link</button>
            </form>
            {% endif %}
            <form method="post" action="/admin/users/{{ user.id }}/{% if user.disabled_at %}enable{% else %}disable{% endif %}" class="yourss-inline-form">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
              <button class="yourss-btn" type="submit">{% if user.disabled_at %}Enable{% else %}Disable{% endif %}</button>
            </form>
            {% if user.role == "admin" %}
            <form method="post" action="/admin/users/{{ user.id }}/role" class="yourss-inline-form">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
              <input type="hidden" name="role" value="user" />
              <button class="yourss-btn" type="submit">Demote</button>
            </form>
            {% else %}
            <form method="post" action="/admin/users/{{ user.id }}/role" class="yourss-inline-form">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
              <input type="hidden" name="role" value="admin" />
              <button class="yourss-btn" type="submit">Promote</button>
            </form>
            {% endif %}
            <form method="post" action="/admin/users/{{ user.id }}/delete" class="yourss-inline-form" onsubmit="return confirm('Delete this user and all their data?')">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
              <button class="yourss-btn yourss-reset-btn" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
