{% extends "pages/base.jinja-html" %}
{% block content %}
{% from "partials/macros.jinja-html" import avatar, state_marker %}
<section class="yourss-account" aria-labelledby="yourss-page-title">
  <header class="yourss-account-head">
    <div>
      <p class="yourss-eyebrow"><a href="/account">Your account</a></p>
      <h1 id="yourss-page-title">{{ page.name }}</h1>
      <p class="yourss-muted">{{ total }} of {{ max_subscriptions }} followed &middot; {{ channels|length }} channels &middot; {{ playlists|length }} playlists</p>
      <p class="yourss-muted">Channels and playlists this page follows through YouTube RSS; not your YouTube subscriptions.</p>
    </div>
    <a class="yourss-btn" href="/u/{{ account.username }}/{{ page.name|urlencode }}">Open page</a>
  </header>

  <div class="yourss-notice" role="status" aria-live="polite">{% if notice %}{{ notice }}{% endif %}</div>

  <section class="yourss-card yourss-follow-card" aria-labelledby="yourss-follow-title">
    <h2 id="yourss-follow-title">Follow a channel or playlist</h2>
    <form method="post" action="/account/pages/{{ page.name|urlencode }}/subscriptions" class="yourss-add-form">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
      {% if cap_reached %}
      <p id="yourss-cap-warning" class="yourss-notice is-warning">This page already follows the maximum of {{ max_subscriptions }} channels and playlists. Remove one to follow another.</p>
      {% endif %}
      <label for="yourss-subscription-ref">Channel, playlist or YouTube link</label>
      <input id="yourss-subscription-ref" name="ref" value="{{ add_ref }}" required
        placeholder="@handle, UC..., PL... or a YouTube link"
        {% if add_error %}aria-invalid="true"{% endif %}
        aria-describedby="yourss-add-hint{% if add_error %} yourss-add-error{% endif %}">
      <p id="yourss-add-hint" class="yourss-muted yourss-add-hint">A handle (@name), a channel ID (UC...), a playlist ID (PL...), or a YouTube link.</p>
      {% if add_error %}
      <p id="yourss-add-error" class="yourss-add-error" role="alert">{{ add_error }}</p>
      {% endif %}
      <button class="yourss-btn" type="submit"{% if cap_reached %} disabled aria-describedby="yourss-cap-warning"{% endif %}>Follow</button>
    </form>
  </section>

  <section class="yourss-card" aria-labelledby="group-channels">
    <h2 id="group-channels" tabindex="-1">Channels <span class="yourss-muted">{{ channels|length }} followed</span></h2>
    {% if channels %}
    <ul class="yourss-sub-list" aria-labelledby="group-channels">
      {% for row in channels %}
      <li id="subscription-{{ row.id }}" class="yourss-sub-row" tabindex="-1" aria-posinset="{{ loop.index }}" aria-setsize="{{ channels|length }}">
        {{ avatar(row.channel, 28) }}
        <span class="yourss-sub-identity">
          <span class="yourss-sub-name">{{ row.label }}</span>
          <span class="yourss-sub-ref">{{ row.ref }}</span>
        </span>
        {{ state_marker(row) }}
        <div class="yourss-sub-actions">
          {% if channels|length > 1 %}
          <form method="post" action="/account/pages/{{ page.name|urlencode }}/subscriptions/{{ row.id }}/move">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
            <input type="hidden" name="direction" value="up" />
            <button class="yourss-icon-btn is-small" type="submit"{% if loop.first %} disabled{% endif %} aria-label="Move {{ row.label }} up in Channels" title="Move up"><svg class="is-flipped"><use href="#i-chevron" /></svg></button>
          </form>
          <form method="post" action="/account/pages/{{ page.name|urlencode }}/subscriptions/{{ row.id }}/move">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
            <input type="hidden" name="direction" value="down" />
            <button class="yourss-icon-btn is-small" type="submit"{% if loop.last %} disabled{% endif %} aria-label="Move {{ row.label }} down in Channels" title="Move down"><svg><use href="#i-chevron" /></svg></button>
          </form>
          {% endif %}
          <form method="post" action="/account/pages/{{ page.name|urlencode }}/subscriptions/{{ row.id }}/delete">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
            <button class="yourss-btn yourss-reset-btn" type="submit" aria-label="Remove {{ row.label }} from {{ page.name }}">Remove</button>
          </form>
        </div>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="yourss-group-note">{% if unresolved|selectattr('kind', 'equalto', 'channel')|list %}No resolved channels yet; unresolved ones are listed below.{% else %}No channels followed yet. Paste a handle, a channel ID, or a YouTube link above.{% endif %}</p>
    {% endif %}
  </section>

  <section class="yourss-card" aria-labelledby="group-playlists">
    <h2 id="group-playlists" tabindex="-1">Playlists <span class="yourss-muted">{{ playlists|length }} followed</span></h2>
    {% if playlists %}
    <ul class="yourss-sub-list" aria-labelledby="group-playlists">
      {% for row in playlists %}
      <li id="subscription-{{ row.id }}" class="yourss-sub-row" tabindex="-1" aria-posinset="{{ loop.index }}" aria-setsize="{{ playlists|length }}">
        <span class="yourss-sub-icon" aria-hidden="true"><svg><use href="#i-list" /></svg></span>
        <span class="yourss-sub-identity">
          <span class="yourss-sub-name">{{ row.label }}</span>
          <span class="yourss-sub-ref">{{ row.ref }}</span>
        </span>
        {{ state_marker(row) }}
        <div class="yourss-sub-actions">
          {% if playlists|length > 1 %}
          <form method="post" action="/account/pages/{{ page.name|urlencode }}/subscriptions/{{ row.id }}/move">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
            <input type="hidden" name="direction" value="up" />
            <button class="yourss-icon-btn is-small" type="submit"{% if loop.first %} disabled{% endif %} aria-label="Move {{ row.label }} up in Playlists" title="Move up"><svg class="is-flipped"><use href="#i-chevron" /></svg></button>
          </form>
          <form method="post" action="/account/pages/{{ page.name|urlencode }}/subscriptions/{{ row.id }}/move">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
            <input type="hidden" name="direction" value="down" />
            <button class="yourss-icon-btn is-small" type="submit"{% if loop.last %} disabled{% endif %} aria-label="Move {{ row.label }} down in Playlists" title="Move down"><svg><use href="#i-chevron" /></svg></button>
          </form>
          {% endif %}
          <form method="post" action="/account/pages/{{ page.name|urlencode }}/subscriptions/{{ row.id }}/delete">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
            <button class="yourss-btn yourss-reset-btn" type="submit" aria-label="Remove {{ row.label }} from {{ page.name }}">Remove</button>
          </form>
        </div>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="yourss-group-note">{% if unresolved|selectattr('kind', 'equalto', 'playlist')|list %}No resolved playlists yet; unresolved ones are listed below.{% else %}No playlists followed yet. Following a playlist reads its RSS feed; it does not edit it.{% endif %}</p>
    {% endif %}
  </section>

  {% if unresolved %}
  <section class="yourss-card" aria-labelledby="group-unresolved">
    <h2 id="group-unresolved" tabindex="-1">Unresolved</h2>
    <ul class="yourss-sub-list" aria-labelledby="group-unresolved">
      {% for row in unresolved %}
      <li id="subscription-{{ row.id }}" class="yourss-sub-row is-unresolved" tabindex="-1">
        <span class="yourss-sub-icon is-warning" aria-hidden="true"><svg><use href="#i-warning" /></svg></span>
        <span class="yourss-sub-identity">
          <span class="yourss-sub-name">name unavailable</span>
          <span class="yourss-sub-ref">{{ row.ref }}</span>
          <span class="yourss-sub-reason">{{ row.reason or 'Could not be fetched' }}</span>
        </span>
        <div class="yourss-sub-actions">
          <form method="post" action="/account/pages/{{ page.name|urlencode }}/subscriptions/{{ row.id }}/delete">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
            <button class="yourss-btn yourss-reset-btn" type="submit" aria-label="Remove {{ row.ref }} from {{ page.name }}">Remove</button>
          </form>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="yourss-card" aria-labelledby="yourss-settings-title">
    <h2 id="yourss-settings-title">Page settings</h2>
    <form method="post" action="/account/pages/{{ page.name|urlencode }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
      <label for="yourss-page-name">Page name</label>
      <input id="yourss-page-name" name="new_name" value="{{ page.name }}" required />
      <label for="yourss-page-publish">Public name (optional)</label>
      <input id="yourss-page-publish" name="publish" value="{{ page.publish or '' }}" />
      <label class="yourss-check"><input type="checkbox" name="warmup" {% if page.warmup %}checked{% endif %} /> Refresh in background</label>
      <button class="yourss-btn" type="submit">Save page</button>
    </form>
    <form method="post" action="/account/pages/{{ page.name|urlencode }}/delete" onsubmit="return confirm('Delete this page and its subscriptions?')">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
      <button class="yourss-btn yourss-reset-btn" type="submit">Delete page</button>
    </form>
  </section>
</section>
{% endblock %}
