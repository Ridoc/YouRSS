{% extends "pages/base.jinja-html" %}
{% block content %}
<section class="yourss-account" aria-labelledby="yourss-page-title">
  <header class="yourss-account-head">
    <div>
      <p class="yourss-eyebrow"><a href="/account">Your account</a></p>
      <h1 id="yourss-page-title">{{ page.name }}</h1>
      <p class="yourss-muted">{{ subscriptions|length }} / {{ max_subscriptions }} subscriptions</p>
    </div>
    <a class="yourss-btn" href="/u/{{ account.username }}/{{ page.name }}">Open page</a>
  </header>

  <section class="yourss-card" aria-labelledby="yourss-settings-title">
    <h2 id="yourss-settings-title">Page settings</h2>
    <form method="post" action="/account/pages/{{ page.name|urlencode }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
      <label for="yourss-page-name">Page name</label>
      <input id="yourss-page-name" name="new_name" value="{{ page.name }}" required />
      <label for="yourss-page-publish">Public name (optional)</label>
      <input id="yourss-page-publish" name="publish" value="{{ page.publish or '' }}" />
      <label class="yourss-check"><input type="checkbox" name="warmup" {% if page.warmup %}checked{% endif %} /> Refresh in background</label>
      <button class="yourss-btn" type="submit">Save page</button>
    </form>
    <form method="post" action="/account/pages/{{ page.name|urlencode }}/delete" onsubmit="return confirm('Delete this page and its subscriptions?')">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
      <button class="yourss-btn yourss-reset-btn" type="submit">Delete page</button>
    </form>
  </section>

  <section class="yourss-card" aria-labelledby="yourss-subscriptions-title">
    <h2 id="yourss-subscriptions-title">Subscriptions</h2>
    {% if subscriptions %}
    <ul class="yourss-list">
      {% for subscription in subscriptions %}
      <li>
        <code>{{ subscription.ref }}</code>
        <span class="yourss-muted">{{ subscription.kind }}</span>
        <form method="post" action="/account/pages/{{ page.name|urlencode }}/subscriptions/{{ subscription.id }}/delete" class="yourss-inline-form">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
          <button class="yourss-btn yourss-reset-btn" type="submit" aria-label="Remove {{ subscription.ref }}">Remove</button>
        </form>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="yourss-empty">No subscriptions yet. Add a channel, a playlist or a video URL.</p>
    {% endif %}
    <form method="post" action="/account/pages/{{ page.name|urlencode }}/subscriptions" class="yourss-inline-form">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
      <label for="yourss-subscription-ref">Channel, playlist or video</label>
      <input id="yourss-subscription-ref" name="ref" required placeholder="@handle, UC…, PL… or a YouTube URL" />
      <button class="yourss-btn" type="submit">Add subscription</button>
    </form>
  </section>
</section>
{% endblock %}
