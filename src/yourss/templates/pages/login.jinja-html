{# Passwordless email login; the legacy password form lives in pages/user-login.jinja-html #}
{% extends "pages/base.jinja-html" %}
{% block content %}
<div class="yourss-login-overlay">
  <div class="yourss-login">
    <svg class="yourss-login-lock" aria-hidden="true"><use href="#i-lock" /></svg>
    <h1>Sign in to {{ display_name }}</h1>
    <p>We send a one-time link. No password to remember.</p>

    {% if sent %}
    <div class="yourss-notice" role="status">
      If that email is registered, a sign-in link is on its way. Check your inbox.
    </div>
    {% endif %}
    <form method="post" action="/auth/request">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
      <input type="hidden" name="next" value="{{ next }}" />
      <label for="yourss-email">Email</label>
      <input id="yourss-email" type="email" name="email" autocomplete="email" inputmode="email"
             placeholder="you@example.com" required autofocus />
      {% if turnstile_site_key %}
      <div class="cf-turnstile" data-sitekey="{{ turnstile_site_key }}" data-theme="auto"></div>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      {% endif %}
      <button type="submit" class="yourss-btn"><span>Send sign-in link</span></button>
    </form>

    {% if legacy_login %}
    <p class="yourss-settings-note">Imported account? Use your old password link from the page you are opening.</p>
    {% endif %}
  </div>
</div>
{% endblock %}
